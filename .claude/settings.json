{
  "permissions": {
    "allow": [
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh release view:*)",
      "Bash(gh api user:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git grep:*)",
      "Bash(git fetch:*)",
      "Bash(docker info:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx expo lint:*)"
    ],
    "deny": [
      "Bash(dotnet ef migrations add:*)",
      "Bash(dotnet ef database update:*)",
      "Bash(gh auth switch:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pr-reminder.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false
}
